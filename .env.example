# Desktop app environment variables (all optional — the app needs no configuration).
# The sync server has its own settings in server/.env.example.

# Use a different data folder (database, logs). Also isolates the single-instance lock.
# BUDDY_USER_DATA=C:\temp\buddy-test

# Write debug logs to the console as well as the log file.
# BUDDY_DEBUG=1

# Turn off chime and speech (used by automated tests).
# BUDDY_MUTE=1

# Set automatically by `npm run dev`: load the task manager from the Vite dev server.
# VITE_DEV_SERVER_URL=http://localhost:5173/
